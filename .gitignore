# =============================================================================
# SERVORA - Global Git Ignore
# =============================================================================

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
*.tmp

# Editor & IDE Directories
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.sublime-project
*.sublime-workspace
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# -----------------------------------------------------------------------------
# Backend (Laravel 12 / PHP)
# -----------------------------------------------------------------------------
backend/vendor/
backend/.env
backend/.env.backup
backend/.env.production
backend/.phpunit.result.cache
backend/.phpunit.cache/
backend/storage/*.key
backend/storage/logs/*.log
backend/storage/framework/cache/data/*
!backend/storage/framework/cache/data/.gitignore
backend/storage/framework/sessions/*
!backend/storage/framework/sessions/.gitignore
backend/storage/framework/views/*
!backend/storage/framework/views/.gitignore
backend/public/storage
backend/public/hot
backend/public/build
backend/auth.json
backend/composer.phar

# -----------------------------------------------------------------------------
# Frontend (React 19 / Vite / Node)
# -----------------------------------------------------------------------------
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/*.local
frontend/.env.local
frontend/.env.*.local
frontend/npm-debug.log*
frontend/yarn-debug.log*
frontend/yarn-error.log*
frontend/pnpm-debug.log*

# Logs & Temporary Files
*.log
*.phar
composer.phar

